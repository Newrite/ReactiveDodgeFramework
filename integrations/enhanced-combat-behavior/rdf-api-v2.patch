+++ b/tests/havok_string_test.cpp
@@ -0,0 +1,24 @@
+#include "HavokString.h"
+
+#include <array>
+#include <cstdlib>
+#include <iostream>
+
+int main()
+{
+    struct StoredString { std::uintptr_t bits; };
+    for (auto address : std::array<std::uintptr_t, 4>{0, 0x245231093c0ULL, 0x7ffe551c2a30ULL, 0x100000000ULL}) {
+        for (std::uintptr_t flag : {0U, 1U}) {
+            const auto decoded = reinterpret_cast<std::uintptr_t>(CombatAI::ReadHavokString(StoredString{address | flag}));
+            if (decoded != address) {
+                return EXIT_FAILURE;
+            }
+        }
+    }
+    alignas(2) const char text[] = "SCAR_ActionData{}";
+    const StoredString stored{reinterpret_cast<std::uintptr_t>(text) | 1};
+    if (std::strcmp(CombatAI::ReadHavokString(stored), text) != 0) {
+        return EXIT_FAILURE;
+    }
+    std::cout << "Havok string regression: 8 address/flag cases and real string passed\n";
+}
