+    void CombatDirector::UpdateRdfDodges()
+    {
+        const auto api = RdfIntegration::Get();
+        if (!api) { return; }
+        std::vector<std::pair<PendingRdfDodge, ReactiveDodgeAPI::Result>> resolved;
+        m_pendingRdf.WithWriteLock([&](auto& entries) {
+            for (auto it = entries.begin(); it != entries.end();) {
+                const auto result = api->Poll(it->second.ticket, true);
+                if (result.status == ReactiveDodgeAPI::RequestStatus::Pending ||
+                    result.status == ReactiveDodgeAPI::RequestStatus::Starting) { ++it; continue; }
+                resolved.emplace_back(it->second, result);
+                it = entries.erase(it);
+            }
+        });
+        for (auto& [pending, result] : resolved) {
+            const auto actor = pending.actor.get();
+            if (!actor || actor->IsDead() || !actor->IsInCombat() || !actor->Is3DLoaded()) { continue; }
+            if (result.status == ReactiveDodgeAPI::RequestStatus::Started) {
+                CompleteDecision(actor.get(), pending.decision, pending.state);
+            } else if (result.status == ReactiveDodgeAPI::RequestStatus::Rejected &&
+                       result.reason != ReactiveDodgeAPI::Reject::Cancelled &&
+                       pending.decision.action == ActionType::ForwardDodge) {
+                // Re-evaluate against the current target/position; don't advance from an old snapshot.
+                const auto state = m_observer.GatherState(actor.get(), 0.0f);
+                if (!state.target.isValid) { continue; }
+                auto fallback = pending.decision;
+                fallback.action = ActionType::Advancing;
+                fallback.direction = state.target.position - state.self.position;
+                fallback.direction.z = 0;
+                fallback.direction.Unitize();
+                if (m_executor.Execute(actor.get(), fallback, state)) { CompleteDecision(actor.get(), fallback, state); }
+            }
+        }
+    }
